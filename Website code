/* General Reset */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
 
  body {
    font-family: Arial, sans-serif;
    line-height: 1.6;
    color: #333;
    background-color: #f4f4f9;
  }
 
  header {
    background: #0073e6;
    color: #fff;
    padding: 1rem 0;
    text-align: center;
  }
 
  header h1 {
    margin-bottom: 0.5rem;
  }
 
  nav {
    margin-top: 1rem;
  }
 
  nav a {
    color: #fff;
    text-decoration: none;
    margin: 0 1rem;
    font-weight: bold;
  }
 
  nav a:hover {
    text-decoration: underline;
  }
 
  section {
    padding: 2rem;
    margin: 1rem auto;
    max-width: 800px;
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  }
 
  section h2 {
    margin-bottom: 1rem;
    color: #0073e6;
  }
 
  img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1rem auto;
    border-radius: 8px;
  }
 
  footer {
    text-align: center;
    padding: 1rem;
    margin-top: 2rem;
    background: #333;
    color: #fff;
  }
 
  /* Responsive Design */
  @media (max-width: 768px) {
    nav {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
 
    nav a {
      margin: 0.5rem 0;
    }
 
    section {
      padding: 1.5rem;
      margin: 1rem;
    }
 
    img {
      width: 100%;
      height: auto;
      margin-top: 1rem;
    }
  }
 
  @media (max-width: 480px) {
    header h1 {
      font-size: 1.5rem;
    }
 
    nav a {
      font-size: 0.9rem;
    }
 
    section {
      padding: 1rem;
    }
 
    footer {
      font-size: 0.9rem;
    }
  }
